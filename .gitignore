!.env.*.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# OCR engine (Phase C) — cloned and built from source into ocr/;
# rebuild with the commands in ocr/README.md. The clones and the
# built binaries are install artifacts, like node_modules — the
# source of truth is the README + ocr/worker.ts + ocr/tessdata/.
/ocr/tesseract/
/ocr/leptonica/
/ocr/vendor/

# Generated at run time by the corpus / fixture generators (Day 26).
# They are rewritten on every run; do not commit them.
scripts/build-corpus-pdf.mjs
scripts/build-img-helper.mjs
scripts/build-pdf1-helper.mjs
scripts/build-scanned-helper.mjs
