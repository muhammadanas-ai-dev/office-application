# Copy to .env.local and fill in. NEVER commit .env.local.
# Public (browser-safe) values:
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
# Server-only (no NEXT_PUBLIC_ prefix, never in client code):
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_REST_URL=https://YOUR_PROJECT_REF.supabase.co/rest/v1/
SUPABASE_SECRET_KEY=sb_secret_your_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
SUPABASE_PROJECT_ID=YOUR_PROJECT_REF
SUPABASE_REGION=ap-southeast-1
SUPABASE_JWT_SECRET=your_jwt_signing_key_here
SUPABASE_LEGACY_JWT_SECRET=your_legacy_jwt_here
# Day 5 — ONLYOFFICE editor integration (server-only secrets):
# The document server URL is public (the browser loads its JS from it).
ONLYOFFICE_DOCSERVER_URL=http://localhost:8080
ONLYOFFICE_JWT_SECRET=your_onlyoffice_jwt_secret_here
EDITOR_FILE_TOKEN_SECRET=your_editor_file_token_secret_here
# URL the document server uses to reach this app (file + callback URLs).
EDITOR_PUBLIC_URL=http://localhost:3000
# Direct Postgres (server-only). If the password contains '#', use %23 in DATABASE_URL.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres"
PGHOST=db.YOUR_PROJECT_REF.supabase.co
PGPORT=5432
PGDATABASE=postgres
PGUSER=postgres
PGPASSWORD="your_postgres_password_here"
